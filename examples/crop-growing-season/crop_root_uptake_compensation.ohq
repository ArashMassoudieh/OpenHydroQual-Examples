create block;type=Crop,ET0=et0_drought.csv,Kcb=1.05,LAI_constant=3,LAI_timeseries=,K_plant=0.01[day],_height=200,_width=200,area=10000[m~^2],compensation=1,h_anoxic=-0.1[m],h_optimal_dry=-5[m],h_optimal_wet=-0.25[m],h_wilting=-160[m],k_extinction=0.6,name=Corn_compensated,root_depth_constant=1[m],root_depth_timeseries=,root_lambda=2,surface_elevation=10[m],x=450,y=500
