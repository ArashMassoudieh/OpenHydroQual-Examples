loadtemplate; filename = main_components.json
addtemplate; filename = unsaturated_soil.json
addtemplate; filename = plants.json
create source;type=Precipitation,name=Rain,timeseries=rainfall_drought.txt
create block;type=Catchment,ManningCoeff=0.15,Precipitation=Rain,_height=200,_width=200,area=10000[m~^2],depth=0[m],elevation=10[m],name=Field_A,x=0,y=0
