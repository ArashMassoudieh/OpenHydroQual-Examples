loadtemplate; filename = main_components.json
addtemplate; filename = open_channel.json
addtemplate; filename = Gate_control.json
create block;type=Trapezoidal Channel Segment,name=Upstream_Pool,base_width=6[m],side_slope=1.5,ManningCoeff=0.025,bottom_elevation=0[m],length=2000[m],depth=2.4[m],inflow=canal_inflow.csv,inflow_multiplier=1,dam_height=0[m],ag_area=0,non_ag_area=0,x=0,y=0,_width=200,_height=200
create block;type=Trapezoidal Channel Segment,name=Downstream_Reach,base_width=6[m],side_slope=1.5,ManningCoeff=0.025,bottom_elevation=-0.5[m],length=2000[m],depth=1.3[m],inflow=,inflow_multiplier=1,dam_height=0[m],ag_area=0,non_ag_area=0,x=400,y=0,_width=200,_height=200
create block;type=fixed_head,name=Canal_Outlet,head=0.5[m],Storage=100000[m~^3],x=800,y=0,_width=200,_height=200
create link;from=Upstream_Pool,to=Downstream_Reach,type=imposed_gate_control_weir,name=Check_Gate,observed_gate_opening_01=gate1_opening.csv,observed_gate_opening_02=gate2_opening.csv,discharge_coefficient=0.7,width=3[m],leakage_area=0.05[m~^2]
create link;from=Downstream_Reach,to=Canal_Outlet,type=channel2fixed,name=Downstream_Outflow
setvalue; object=system, quantity=alloutputfile, value=output.txt
setvalue; object=system, quantity=simulation_start_time, value=0
setvalue; object=system, quantity=simulation_end_time, value=10
setvalue; object=system, quantity=initial_time_step, value=0.001
setvalue; object=system, quantity=minimum_timestep, value=1e-06
setvalue; object=system, quantity=max_timestep_increase_factor, value=20
setvalue; object=system, quantity=write_interval, value=1
