create reaction_parameter;type=ReactionParameter,Arrhenius_factor=1,base_value=0.4,name=porosity,reference_temperature=20,temperature=
create reaction;type=Reaction,Cu_aq:stoichiometric_constant=-1,Cu_s:stoichiometric_constant=(porosity/rho_b),name=Adsorption,rate_expression=(k_f*Cu_aq)
create reaction;type=Reaction,Cu_aq:stoichiometric_constant=1,Cu_s:stoichiometric_constant=(0-porosity/rho_b),name=Desorption,rate_expression=(k_f/K_D*Cu_s)
