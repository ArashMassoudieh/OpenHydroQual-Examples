loadtemplate; filename = main_components.json
addtemplate; filename = Pond_Plugin.json
addtemplate; filename = unsaturated_soil.json
addtemplate; filename = Sewer_system.json
addtemplate; filename = soil_evapotranspiration_models.json
create source;type=Precipitation,name=Rain,timeseries=rainfall.txt
create source;type=Evapotranspiration_Penman (Soil),name=Penman_ET,Temperature=air_temperature.csv,R_h=relative_humidity.csv,solar_radiation=solar_radiation.csv,wind_speed=wind_speed.csv,solar_scale_fact=0.5,wind_scale_fact=1,z2=10[m],z0=0.0003[m],gamma=66.8
create block;type=Catchment,name=Parking_Area,area=2000[m~^2],Width=40[m],Slope=0.02,ManningCoeff=0.015,Runoff_coeff=1,depression_storage=0[m],depth=0[m],elevation=0.5[m],loss_coefficient=0[1/day],inflow=,Precipitation=Rain,Evapotranspiration=,_width=200,_height=200,x=200,y=0
create block;type=Pond,name=Ponding_Zone,Storage=0[m~^3],alpha=100,alpha_multiplier=1,beta=1,bottom_elevation=0[m],inflow=,Precipitation=Rain,Evapotranspiration=,_width=200,_height=200,x=700,y=0
create block;type=Soil,name=Media_1,area=100[m~^2],depth=0.2[m],bottom_elevation=-0.2[m],theta=0.12,theta_sat=0.41,theta_res=0.057,alpha=12.4[1/m],n=2.28,K_sat_original=1.5[m/day],K_sat_scale_factor=1,specific_storage=0.01[1/m],aniso_ratio=1,Evapotranspiration=Penman_ET,inflow=,_width=200,_height=200,x=700,y=300
create block;type=Soil,name=Media_2,area=100[m~^2],depth=0.2[m],bottom_elevation=-0.4[m],theta=0.12,theta_sat=0.41,theta_res=0.057,alpha=12.4[1/m],n=2.28,K_sat_original=1.5[m/day],K_sat_scale_factor=1,specific_storage=0.01[1/m],aniso_ratio=1,Evapotranspiration=,inflow=,_width=200,_height=200,x=700,y=550
create block;type=Soil,name=Media_3,area=100[m~^2],depth=0.2[m],bottom_elevation=-0.6[m],theta=0.12,theta_sat=0.41,theta_res=0.057,alpha=12.4[1/m],n=2.28,K_sat_original=1.5[m/day],K_sat_scale_factor=1,specific_storage=0.01[1/m],aniso_ratio=1,Evapotranspiration=,inflow=,_width=200,_height=200,x=700,y=800
create block;type=Aggregate_storage_layer,name=Gravel_Storage,area=100[m~^2],bottom_elevation=-0.9[m],depth=0.05[m],porosity=0.4,K_sat=100[m/day],inflow=,_width=200,_height=200,x=700,y=1050
create block;type=Soil,name=Native_Soil_1,area=100[m~^2],depth=0.5[m],bottom_elevation=-1.4[m],theta=0.3,theta_sat=0.43,theta_res=0.078,alpha=3.6[1/m],n=1.56,K_sat_original=0.25[m/day],K_sat_scale_factor=1,specific_storage=0.01[1/m],aniso_ratio=1,Evapotranspiration=,inflow=,_width=200,_height=200,x=700,y=1300
create block;type=Soil,name=Native_Soil_2,area=100[m~^2],depth=0.5[m],bottom_elevation=-1.9[m],theta=0.3,theta_sat=0.43,theta_res=0.078,alpha=3.6[1/m],n=1.56,K_sat_original=0.25[m/day],K_sat_scale_factor=1,specific_storage=0.01[1/m],aniso_ratio=1,Evapotranspiration=,inflow=,_width=200,_height=200,x=700,y=1550
create block;type=fixed_head,name=Water_Table,head=-1.9[m],Storage=100000[m~^3],area=1[m~^2],_width=200,_height=200,x=700,y=1800
create block;type=fixed_head,name=Storm_Sewer,head=-1.5[m],Storage=100000[m~^3],area=1[m~^2],_width=200,_height=200,x=1250,y=550
create link;type=Catchment_link,name=Runoff,from=Parking_Area,to=Ponding_Zone
create link;type=wier,name=Overflow,from=Ponding_Zone,to=Storm_Sewer,crest_elevation=0.25[m],alpha=146880,beta=1.5
create link;type=surfacewater_to_soil_link,name=Infiltration,from=Ponding_Zone,to=Media_1
create link;type=soil_to_soil_link,name=Media_1_to_2,from=Media_1,to=Media_2
create link;type=soil_to_soil_link,name=Media_2_to_3,from=Media_2,to=Media_3
create link;type=soil_to_aggregate_link,name=Media_to_Gravel,from=Media_3,to=Gravel_Storage
create link;type=Sewer_pipe,name=Underdrain,from=Gravel_Storage,to=Storm_Sewer,diameter=0.1[m],ManningCoeff=0.013,length=10[m],start_elevation=-0.8[m],end_elevation=-1.0[m]
create link;type=aggregate_to_soil_link,name=Exfiltration,from=Gravel_Storage,to=Native_Soil_1
create link;type=soil_to_soil_link,name=Native_1_to_2,from=Native_Soil_1,to=Native_Soil_2
create link;type=soil_to_fixedhead_link,name=Recharge,from=Native_Soil_2,to=Water_Table
setvalue; object=system, quantity=alloutputfile, value=output.txt
setvalue; object=system, quantity=simulation_start_time, value=0
setvalue; object=system, quantity=simulation_end_time, value=96.0
setvalue; object=system, quantity=initial_time_step, value=0.001
setvalue; object=system, quantity=minimum_timestep, value=1e-06
setvalue; object=system, quantity=write_interval, value=10
