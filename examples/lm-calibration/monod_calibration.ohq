loadtemplate; filename = main_components.json
addtemplate; filename = mass_transfer.json
create constituent;type=Constituent,concentration=0,constant_inflow_concentration=0,diffusion_coefficient=0,dispersivity=0,external_mass_flow_timeseries=,external_source=,name=A,stoichiometric_constant=0,time_variable_inflow_concentration=
create constituent;type=Constituent,concentration=0,constant_inflow_concentration=0,diffusion_coefficient=0,dispersivity=0,external_mass_flow_timeseries=,external_source=,name=B,stoichiometric_constant=0,time_variable_inflow_concentration=
create reaction_parameter;type=ReactionParameter,Arrhenius_factor=1.05,base_value=0.35,name=k_A,reference_temperature=20,temperature=monod_temperature.txt
create reaction_parameter;type=ReactionParameter,Arrhenius_factor=1,base_value=1.6,name=k_B,reference_temperature=0,temperature=
create reaction_parameter;type=ReactionParameter,Arrhenius_factor=1,base_value=2.5,name=K_s,reference_temperature=0,temperature=
create reaction;type=Reaction,A:stoichiometric_constant=-1,B:stoichiometric_constant=0,name=A_Decay,rate_expression=(k_A*A/(K_s+A))
create reaction;type=Reaction,A:stoichiometric_constant=0,B:stoichiometric_constant=-1,name=B_Decay,rate_expression=(k_B*B^2)
create block;type=Reactor,A:concentration=2,A:constant_inflow_concentration=0,A:external_mass_flow_timeseries=,A:external_source=,A:time_variable_inflow_concentration=,B:concentration=2,B:constant_inflow_concentration=0,B:external_mass_flow_timeseries=,B:external_source=,B:time_variable_inflow_concentration=,Storage=10[m~^3],_height=200,_width=200,bottom_elevation=0,constant_inflow=0,name=Reactor,time_variable_inflow=monod_inflow.txt [m~^3/day],x=400,y=300
create observation;type=Observation,name=A_conc,object=Reactor,expression=A:concentration,error_structure=normal,error_standard_deviation=0.05,observed_data=monod_obs_A.csv
create observation;type=Observation,name=B_conc,object=Reactor,expression=B:concentration,error_structure=normal,error_standard_deviation=0.05,observed_data=monod_obs_B.csv
create parameter;type=Parameter,name=p_k_A,low=0.02,high=20,value=0.35,prior_distribution=log-normal
setasparameter; object=k_A, quantity=base_value, parametername=p_k_A
create parameter;type=Parameter,name=p_K_s,low=0.02,high=20,value=2.5,prior_distribution=log-normal
setasparameter; object=K_s, quantity=base_value, parametername=p_K_s
create parameter;type=Parameter,name=p_k_B,low=0.02,high=20,value=1.6,prior_distribution=log-normal
setasparameter; object=k_B, quantity=base_value, parametername=p_k_B
create parameter;type=Parameter,name=sigma_A_conc,low=0.0001,high=2,value=0.05,prior_distribution=log-normal
setasparameter; object=A_conc, quantity=error_standard_deviation, parametername=sigma_A_conc
create parameter;type=Parameter,name=sigma_B_conc,low=0.0001,high=2,value=0.05,prior_distribution=log-normal
setasparameter; object=B_conc, quantity=error_standard_deviation, parametername=sigma_B_conc
setvalue; object=system, quantity=alloutputfile, value=output.txt
setvalue; object=system, quantity=observed_outputfile, value=observedoutput.txt
setvalue; object=system, quantity=simulation_end_time, value=5
setvalue; object=system, quantity=simulation_start_time, value=0
setvalue; object=system, quantity=initial_time_step, value=0.01
setvalue; object=system, quantity=max_timestep_decrease_factor, value=100000
setvalue; object=system, quantity=max_timestep_increase_factor, value=50
setvalue; object=system, quantity=minimum_timestep, value=1e-08
setvalue; object=system, quantity=nr_tolerance, value=1e-09
setvalue; object=system, quantity=write_interval, value=100
setvalue; object=LM, quantity=max_iterations, value=40
setvalue; object=LM, quantity=lm_numthreads, value=4
