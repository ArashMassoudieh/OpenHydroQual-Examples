loadtemplate; filename = main_components.json
addtemplate; filename = Pond_Plugin.json
addtemplate; filename = precipitation_forcast.json
create source;type=Precipitation,name=Rain,timeseries=rainfall.csv
create block;type=Catchment,name=Catchment_A,x=0,y=0,_width=200,_height=200,area=10000[m~^2],Width=100[m],Slope=0.01,ManningCoeff=0.015,depression_storage=0.001[m],Runoff_coeff=1,loss_coefficient=0[1/day],elevation=5[m],depth=0[m],Precipitation=Rain
create block;type=Catchment,name=Catchment_B,x=0,y=450,_width=200,_height=200,area=10000[m~^2],Width=100[m],Slope=0.01,ManningCoeff=0.015,depression_storage=0.001[m],Runoff_coeff=1,loss_coefficient=0[1/day],elevation=5[m],depth=0[m],Precipitation=Rain
create block;type=Pond,name=Smart_Pond,x=400,y=0,_width=200,_height=200,alpha=133.3,beta=2,bottom_elevation=0[m],Storage=150[m~^3],Precipitation=Rain
create block;type=Pond,name=Passive_Pond,x=400,y=450,_width=200,_height=200,alpha=133.3,beta=2,bottom_elevation=0[m],Storage=150[m~^3],Precipitation=Rain
create block;type=fixed_head,name=Stream,x=850,y=225,_width=200,_height=200,head=-1[m],Storage=100000[m~^3]
create link;type=Catchment_link,from=Catchment_A,to=Smart_Pond,name=Runoff_A
create link;type=Catchment_link,from=Catchment_B,to=Passive_Pond,name=Runoff_B
create link;type=Flow_control_device_(Gaussian_Kernel),from=Smart_Pond,to=Stream,name=Forecast_Valve,timeseries=rainfall.csv,kernel_delay_parameter=2[day],kernel_spread_parameter=1[day],S_min=0[m/day],S_max=0.005[m/day],Q_min=0[m~^3/day],Q_max=200[m~^3/day],flow_coefficient=1
create link;type=wier,from=Smart_Pond,to=Stream,name=Smart_Spillway,crest_elevation=1.5[m],alpha=290000,beta=1.5
create link;type=wier,from=Passive_Pond,to=Stream,name=Passive_Spillway,crest_elevation=1.5[m],alpha=290000,beta=1.5
setvalue; object=system, quantity=alloutputfile, value=output.txt
setvalue; object=system, quantity=simulation_start_time, value=0
setvalue; object=system, quantity=simulation_end_time, value=152
setvalue; object=system, quantity=initial_time_step, value=0.01
setvalue; object=system, quantity=minimum_timestep, value=1e-06
setvalue; object=system, quantity=write_interval, value=1
setvalue; object=system, quantity=max_timestep_increase_factor, value=1
