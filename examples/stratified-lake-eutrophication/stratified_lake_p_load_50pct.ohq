create reaction;type=Reaction,Algae:stoichiometric_constant=1,POC:stoichiometric_constant=0,ON:stoichiometric_constant=0,OP:stoichiometric_constant=0,PIP:stoichiometric_constant=0,PO4:stoichiometric_constant=(0-a_PC),NH3:stoichiometric_constant=(0-a_NC),NOx:stoichiometric_constant=0,O2:stoichiometric_constant=r_OC,ODU:stoichiometric_constant=0,N2:stoichiometric_constant=0,Fe_ox:stoichiometric_constant=0,name=Growth_on_NH3,rate_expression=(mu_max*theta_g^(T_water-20)*_log((K_I+PAR)/(K_I+PAR*_exp(0-(k_bg+k_chl*chl_C*Algae)*depth)))/((k_bg+k_chl*chl_C*Algae)*depth)*(NH3+NOx)/(K_N+NH3+NOx)*PO4/(K_P+PO4)*Algae*(NH3*NOx/((K_NH+NH3)*(K_NH+NOx))+NH3*K_NH/((NH3+NOx)*(K_NH+NOx))))
create reaction;type=Reaction,Algae:stoichiometric_constant=1,POC:stoichiometric_constant=0,ON:stoichiometric_constant=0,OP:stoichiometric_constant=0,PIP:stoichiometric_constant=0,PO4:stoichiometric_constant=(0-a_PC),NH3:stoichiometric_constant=0,NOx:stoichiometric_constant=(0-a_NC),O2:stoichiometric_constant=(r_OC+r_ON*a_NC),ODU:stoichiometric_constant=0,N2:stoichiometric_constant=0,Fe_ox:stoichiometric_constant=0,name=Growth_on_NOx,rate_expression=(mu_max*theta_g^(T_water-20)*_log((K_I+PAR)/(K_I+PAR*_exp(0-(k_bg+k_chl*chl_C*Algae)*depth)))/((k_bg+k_chl*chl_C*Algae)*depth)*(NH3+NOx)/(K_N+NH3+NOx)*PO4/(K_P+PO4)*Algae*(1-(NH3*NOx/((K_NH+NH3)*(K_NH+NOx))+NH3*K_NH/((NH3+NOx)*(K_NH+NOx)))))
create reaction;type=Reaction,Algae:stoichiometric_constant=-1,POC:stoichiometric_constant=0,ON:stoichiometric_constant=0,OP:stoichiometric_constant=0,PIP:stoichiometric_constant=0,PO4:stoichiometric_constant=a_PC,NH3:stoichiometric_constant=a_NC,NOx:stoichiometric_constant=0,O2:stoichiometric_constant=(0-r_OC),ODU:stoichiometric_constant=0,N2:stoichiometric_constant=0,Fe_ox:stoichiometric_constant=0,name=Algal_respiration,rate_expression=(k_resp*theta_a^(T_water-20)*Algae*O2/(K_O+O2))
create reaction;type=Reaction,Algae:stoichiometric_constant=-1,POC:stoichiometric_constant=1,ON:stoichiometric_constant=a_NC,OP:stoichiometric_constant=a_PC,PIP:stoichiometric_constant=0,PO4:stoichiometric_constant=0,NH3:stoichiometric_constant=0,NOx:stoichiometric_constant=0,O2:stoichiometric_constant=0,ODU:stoichiometric_constant=0,N2:stoichiometric_constant=0,Fe_ox:stoichiometric_constant=0,name=Algal_mortality,rate_expression=(k_mort*theta_a^(T_water-20)*Algae)
create reaction;type=Reaction,Algae:stoichiometric_constant=0,POC:stoichiometric_constant=-1,ON:stoichiometric_constant=0,OP:stoichiometric_constant=0,PIP:stoichiometric_constant=0,PO4:stoichiometric_constant=0,NH3:stoichiometric_constant=0,NOx:stoichiometric_constant=0,O2:stoichiometric_constant=(0-r_OC),ODU:stoichiometric_constant=0,N2:stoichiometric_constant=0,Fe_ox:stoichiometric_constant=0,name=POC_aerobic_oxidation,rate_expression=(k_C*theta_m^(T_water-20)*POC*O2/(K_O+O2))
create reaction;type=Reaction,Algae:stoichiometric_constant=0,POC:stoichiometric_constant=-1,ON:stoichiometric_constant=0,OP:stoichiometric_constant=0,PIP:stoichiometric_constant=0,PO4:stoichiometric_constant=0,NH3:stoichiometric_constant=0,NOx:stoichiometric_constant=(0-a_dn),O2:stoichiometric_constant=0,ODU:stoichiometric_constant=0,N2:stoichiometric_constant=a_dn,Fe_ox:stoichiometric_constant=0,name=Denitrification,rate_expression=(k_C*theta_m^(T_water-20)*POC*K_O/(K_O+O2)*NOx/(K_NOx+NOx))
create reaction;type=Reaction,Algae:stoichiometric_constant=0,POC:stoichiometric_constant=-1,ON:stoichiometric_constant=0,OP:stoichiometric_constant=0,PIP:stoichiometric_constant=0,PO4:stoichiometric_constant=0,NH3:stoichiometric_constant=0,NOx:stoichiometric_constant=0,O2:stoichiometric_constant=0,ODU:stoichiometric_constant=r_OC,N2:stoichiometric_constant=0,Fe_ox:stoichiometric_constant=0,name=POC_anaerobic_oxidation,rate_expression=(f_an*k_C*theta_m^(T_water-20)*POC*K_O/(K_O+O2)*K_NOx/(K_NOx+NOx))
create reaction;type=Reaction,Algae:stoichiometric_constant=0,POC:stoichiometric_constant=0,ON:stoichiometric_constant=0,OP:stoichiometric_constant=0,PIP:stoichiometric_constant=0,PO4:stoichiometric_constant=0,NH3:stoichiometric_constant=0,NOx:stoichiometric_constant=0,O2:stoichiometric_constant=-1,ODU:stoichiometric_constant=-1,N2:stoichiometric_constant=0,Fe_ox:stoichiometric_constant=0,name=ODU_oxidation,rate_expression=(k_odu*theta_m^(T_water-20)*ODU*O2/(K_O+O2))
create reaction;type=Reaction,Algae:stoichiometric_constant=0,POC:stoichiometric_constant=0,ON:stoichiometric_constant=-1,OP:stoichiometric_constant=0,PIP:stoichiometric_constant=0,PO4:stoichiometric_constant=0,NH3:stoichiometric_constant=1,NOx:stoichiometric_constant=0,O2:stoichiometric_constant=0,ODU:stoichiometric_constant=0,N2:stoichiometric_constant=0,Fe_ox:stoichiometric_constant=0,name=Ammonification,rate_expression=(k_ON*theta_m^(T_water-20)*ON)
create reaction;type=Reaction,Algae:stoichiometric_constant=0,POC:stoichiometric_constant=0,ON:stoichiometric_constant=0,OP:stoichiometric_constant=-1,PIP:stoichiometric_constant=0,PO4:stoichiometric_constant=1,NH3:stoichiometric_constant=0,NOx:stoichiometric_constant=0,O2:stoichiometric_constant=0,ODU:stoichiometric_constant=0,N2:stoichiometric_constant=0,Fe_ox:stoichiometric_constant=0,name=OP_mineralization,rate_expression=(k_OP*theta_m^(T_water-20)*OP)
create reaction;type=Reaction,Algae:stoichiometric_constant=0,POC:stoichiometric_constant=0,ON:stoichiometric_constant=0,OP:stoichiometric_constant=0,PIP:stoichiometric_constant=0,PO4:stoichiometric_constant=0,NH3:stoichiometric_constant=-1,NOx:stoichiometric_constant=1,O2:stoichiometric_constant=(0-r_ON),ODU:stoichiometric_constant=0,N2:stoichiometric_constant=0,Fe_ox:stoichiometric_constant=0,name=Nitrification,rate_expression=(k_nit*theta_n^(T_water-20)*NH3*O2/(K_O_nit+O2))
create reaction;type=Reaction,Algae:stoichiometric_constant=0,POC:stoichiometric_constant=0,ON:stoichiometric_constant=0,OP:stoichiometric_constant=0,PIP:stoichiometric_constant=1,PO4:stoichiometric_constant=-1,NH3:stoichiometric_constant=0,NOx:stoichiometric_constant=0,O2:stoichiometric_constant=0,ODU:stoichiometric_constant=0,N2:stoichiometric_constant=0,Fe_ox:stoichiometric_constant=0,name=P_sorption,rate_expression=(k_sorb*Fe_ox*PO4*O2/(K_Fe+O2))
create reaction;type=Reaction,Algae:stoichiometric_constant=0,POC:stoichiometric_constant=0,ON:stoichiometric_constant=0,OP:stoichiometric_constant=0,PIP:stoichiometric_constant=-1,PO4:stoichiometric_constant=1,NH3:stoichiometric_constant=0,NOx:stoichiometric_constant=0,O2:stoichiometric_constant=0,ODU:stoichiometric_constant=0,N2:stoichiometric_constant=0,Fe_ox:stoichiometric_constant=0,name=P_release,rate_expression=(k_rel*theta_m^(T_water-20)*PIP*K_Fe/(K_Fe+O2))
