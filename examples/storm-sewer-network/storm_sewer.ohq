loadtemplate; filename = main_components.json
addtemplate; filename = Sewer_system.json
setvalue; object=system, quantity=chain_write_interval, value=50
setvalue; object=system, quantity=alloutputfile, value=output.txt
setvalue; object=system, quantity=c_n_weight, value=1
setvalue; object=system, quantity=jacobian_assembly, value=Dependency
setvalue; object=system, quantity=jacobian_dt_refresh_factor, value=2
setvalue; object=system, quantity=jacobian_method, value=Direct
setvalue; object=system, quantity=make_timeseries_uniform, value=Yes
setvalue; object=system, quantity=max_timestep_decrease_factor, value=100000
setvalue; object=system, quantity=max_timestep_increase_factor, value=50
setvalue; object=system, quantity=maximum_number_of_matrix_inverstions, value=200000
setvalue; object=system, quantity=maximum_time_allowed, value=86400
setvalue; object=system, quantity=minimum_timestep, value=1e-06
setvalue; object=system, quantity=n_threads, value=8
setvalue; object=system, quantity=nr_block_tolerance, value=0.001
setvalue; object=system, quantity=nr_niteration_lower, value=20
setvalue; object=system, quantity=nr_niteration_upper, value=40
setvalue; object=system, quantity=nr_timestep_reduction_factor, value=0.75
setvalue; object=system, quantity=nr_timestep_reduction_factor_fail, value=0.2
setvalue; object=system, quantity=nr_tolerance, value=0.001
setvalue; object=system, quantity=rate_output_interpolation, value=midpoint
setvalue; object=system, quantity=timestep_clamp_series, value=Precipitation only
setvalue; object=system, quantity=update_jacobian_every_iteration, value=No
setvalue; object=system, quantity=verify_jacobian, value=
setvalue; object=system, quantity=write_interval, value=100
setvalue; object=system, quantity=simulation_start_time, value=0
setvalue; object=system, quantity=simulation_end_time, value=0.5
setvalue; object=system, quantity=initial_time_step, value=0.0001
