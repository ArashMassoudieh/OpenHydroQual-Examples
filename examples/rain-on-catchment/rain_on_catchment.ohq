loadtemplate; filename = main_components.json
create source;type=Precipitation,name=Rainfall,timeseries=rainfall.csv[mm]
create block;type=Catchment,Evapotranspiration=,ManningCoeff=0.015,Precipitation=Rainfall,Runoff_coeff=0.9,Slope=0.005,Width=100[m],_height=200,_width=200,area=12000[m~^2],depression_storage=0[m],depth=0[m],elevation=0[m],inflow=,loss_coefficient=0[1/day],name=Catchment,x=0,y=400
create block;type=fixed_head,Storage=100000[m~^3],_height=200,_width=200,head=0[m],name=Outlet,x=600,y=400
create link;from=Catchment,to=Outlet,type=Catchment_link,name=Runoff
setvalue; object=system, quantity=alloutputfile, value=output.txt
setvalue; object=system, quantity=simulation_start_time, value=0
setvalue; object=system, quantity=simulation_end_time, value=36
setvalue; object=system, quantity=initial_time_step, value=0.01
setvalue; object=system, quantity=max_timestep_increase_factor, value=4
setvalue; object=system, quantity=minimum_timestep, value=1e-06
setvalue; object=system, quantity=write_interval, value=10
