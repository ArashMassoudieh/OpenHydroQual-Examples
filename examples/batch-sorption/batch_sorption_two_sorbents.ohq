loadtemplate; filename = main_components.json
addtemplate; filename = mass_transfer.json
create constituent;type=Constituent,concentration=0[g/m~^3],constant_inflow_concentration=0[g/m~^3],diffusion_coefficient=0[m~^2/day],dispersivity=0[m],external_mass_flow_timeseries=,external_source=,name=Cu_aq,stoichiometric_constant=0,time_variable_inflow_concentration=
create constituent;type=Constituent,concentration=0[g/m~^3],constant_inflow_concentration=0[g/m~^3],diffusion_coefficient=0[m~^2/day],dispersivity=0[m],external_mass_flow_timeseries=,external_source=,name=Cu_s_1,stoichiometric_constant=0,time_variable_inflow_concentration=
create constituent;type=Constituent,concentration=0[g/m~^3],constant_inflow_concentration=0[g/m~^3],diffusion_coefficient=0[m~^2/day],dispersivity=0[m],external_mass_flow_timeseries=,external_source=,name=Cu_s_2,stoichiometric_constant=0,time_variable_inflow_concentration=
create reaction_parameter;type=ReactionParameter,Arrhenius_factor=1,base_value=5,name=k_1,reference_temperature=20,temperature=
create reaction_parameter;type=ReactionParameter,Arrhenius_factor=1,base_value=0.02,name=K_d_1,reference_temperature=20,temperature=
create reaction_parameter;type=ReactionParameter,Arrhenius_factor=1,base_value=40,name=m_1,reference_temperature=20,temperature=
create reaction_parameter;type=ReactionParameter,Arrhenius_factor=1,base_value=0.2,name=k_2,reference_temperature=20,temperature=
create reaction_parameter;type=ReactionParameter,Arrhenius_factor=1,base_value=0.5,name=K_d_2,reference_temperature=20,temperature=
create reaction_parameter;type=ReactionParameter,Arrhenius_factor=1,base_value=10,name=m_2,reference_temperature=20,temperature=
create reaction;type=Reaction,Cu_aq:stoichiometric_constant=-1,Cu_s_1:stoichiometric_constant=1,Cu_s_2:stoichiometric_constant=0,name=Sorption_1,rate_expression=(k_1*(Cu_aq-Cu_s_1/(m_1*K_d_1)))
create reaction;type=Reaction,Cu_aq:stoichiometric_constant=-1,Cu_s_1:stoichiometric_constant=0,Cu_s_2:stoichiometric_constant=1,name=Sorption_2,rate_expression=(k_2*(Cu_aq-Cu_s_2/(m_2*K_d_2)))
create block;type=Reactor,Cu_aq:concentration=10[g/m~^3],Cu_s_1:concentration=0[g/m~^3],Cu_s_2:concentration=0[g/m~^3],Storage=1[m~^3],_height=200,_width=200,bottom_elevation=0[m],constant_inflow=0[m~^3/day],name=Sorption_test,time_variable_inflow=,x=300,y=300
create block;type=Reactor,Cu_aq:concentration=0[g/m~^3],Cu_s_1:concentration=8[g/m~^3],Cu_s_2:concentration=50[g/m~^3],Storage=1[m~^3],_height=200,_width=200,bottom_elevation=0[m],constant_inflow=0[m~^3/day],name=Desorption_test,time_variable_inflow=,x=700,y=300
setvalue; object=system, quantity=alloutputfile, value=output.txt
setvalue; object=system, quantity=simulation_start_time, value=0
setvalue; object=system, quantity=simulation_end_time, value=20
setvalue; object=system, quantity=initial_time_step, value=0.001
setvalue; object=system, quantity=minimum_timestep, value=1e-06
setvalue; object=system, quantity=max_timestep_increase_factor, value=10
setvalue; object=system, quantity=write_interval, value=5
