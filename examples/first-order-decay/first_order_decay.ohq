loadtemplate; filename = main_components.json
addtemplate; filename = mass_transfer.json
create constituent;type=Constituent,concentration=0[g/m~^3],constant_inflow_concentration=0[g/m~^3],diffusion_coefficient=0[m~^2/s],dispersivity=0[m],external_mass_flow_timeseries=,external_source=,name=A,stoichiometric_constant=0,time_variable_inflow_concentration=
create reaction_parameter;type=ReactionParameter,Arrhenius_factor=1,base_value=0.7,name=k,reference_temperature=20,temperature=
create reaction;type=Reaction,A:stoichiometric_constant=-1,name=Decay,rate_expression=(k*A)
create block;type=Reactor,A:concentration=2[g/m~^3],A:constant_inflow_concentration=0[g/m~^3],A:external_mass_flow_timeseries=,A:external_source=,A:time_variable_inflow_concentration=,Storage=1[m~^3],_height=200,_width=200,bottom_elevation=0[m],constant_inflow=0[m~^3/day],name=Batch_Reactor,time_variable_inflow=,x=400,y=300
setvalue; object=system, quantity=alloutputfile, value=output.txt
setvalue; object=system, quantity=simulation_start_time, value=0
setvalue; object=system, quantity=simulation_end_time, value=5
setvalue; object=system, quantity=initial_time_step, value=0.01
setvalue; object=system, quantity=max_timestep_increase_factor, value=1
setvalue; object=system, quantity=minimum_timestep, value=1e-06
setvalue; object=system, quantity=write_interval, value=10
