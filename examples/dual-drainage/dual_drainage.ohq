loadtemplate; filename = main_components.json
addtemplate; filename = unsaturated_soil.json
addtemplate; filename = unconfined_groundwater.json
addtemplate; filename = open_channel.json
addtemplate; filename = soil_evapotranspiration_models.json
addtemplate; filename = urban_hru.json
addtemplate; filename = compound_channel.json
addtemplate; filename = Sewer_system.json
addtemplate; filename = dual_drainage.json
create source;type=Precipitation,name=Rain,timeseries=rainfall.csv
create source;type=Evapotranspiration_Time_Series (Soil),name=ET,corr_fact=0.8,ET_timeseries=reference_et.csv
create composite;type=Urban_HRU,name=Neighbourhood,x=0,y=170,_width=260,_height=260,area=400000[m~^2],impervious_fraction=0.30,impervious_multiplier=1,surface_elevation=100[m],depth_to_groundwater=3.5[m],groundwater_thickness=12[m],Precipitation=Rain,Evapotranspiration=ET,catchment_slope=0.03,catchment_width=4000[m],manning_coefficient=0.15,depression_storage=0.005[m],runoff_coefficient=1,impervious_manning_coefficient=0.015,impervious_depression_storage=0.0015[m],K_sat_1=0.6[m/day],K_sat_2=0.4[m/day],K_sat_3=0.8[m/day],alpha_vG_1=1.5[1/m],alpha_vG_2=1.2[1/m],alpha_vG_3=2.0[1/m],n_vG_1=1.35,n_vG_2=1.35,n_vG_3=1.45,theta_sat_1=0.42,theta_sat_2=0.40,theta_sat_3=0.36,theta_res_1=0.06,theta_res_2=0.06,theta_res_3=0.04,soil_specific_storage=0.01[1/m],initial_moisture_content=0.25,K_sat_scale=1,groundwater_K=1[m/day],groundwater_porosity=0.15,initial_water_table_elevation=90.3[m],reach_base_width=1[m],reach_side_slope=2,reach_manning_coefficient=0.05,reach_length=300[m],initial_reach_depth=0.01[m],impervious_reach_base_width=1[m],impervious_reach_side_slope=2,impervious_reach_manning_coefficient=0.02,impervious_reach_length=300[m],initial_impervious_reach_depth=0.01[m]
create block;type=Compound Channel Segment,name=Street,x=450,y=0,_width=200,_height=200,channel_coeff=2.0,channel_exponent=2.0,bank_depth=0.15[m],pool_depth=0[m],floodplain_width=10[m],floodplain_side_slope=20,ManningCoeff=0.03,bottom_elevation=95[m],length=800[m],depth=0.001[m]
create block;type=Sewerchannelsegment,name=Storm_Sewer,x=450,y=400,_width=200,_height=200,diameter=0.6[m],ManningCoeff=0.013,bottom_elevation=93[m],length=800[m],depth=0.001[m],surcharge_coefficient=0.11
create block;type=Compound Channel Segment,name=Stream,x=850,y=200,_width=200,_height=200,channel_coeff=6,channel_exponent=1.5,bank_depth=0.6[m],pool_depth=0[m],floodplain_width=10[m],floodplain_side_slope=10,ManningCoeff=0.04,bottom_elevation=90[m],length=600[m],depth=0.05[m]
create block;type=fixed_head,name=Outlet,x=1250,y=200,_width=200,_height=200,head=89[m],Storage=100000[m~^3]
create link;type=Reach_link,from=Neighbourhood,to=Street,name=Pervious_outlet
create link;type=Impervious_Reach_link,from=Neighbourhood,to=Street,name=Impervious_outlet
create link;type=unconfined_groundwater_to_stream,from=Neighbourhood,to=Stream,name=Baseflow,area=6000[m~^2],length=150[m],hydraulic_conductivity=5[m/day]
create link;type=Swale_to_pipe_inlet,from=Street,to=Storm_Sewer,name=Inlets,inlet_area=1.5[m~^2],inlet_perimeter=20[m],discharge_coefficient=0.67,weir_coefficient=1.66,inlet_elevation=95[m],smoothing_depth=0.005[m],one_way=0
create link;type=Pipe_outfall_link,from=Storm_Sewer,to=Stream,name=Outfall,outfall_invert=91[m]
create link;type=Compound_Channel_link,from=Street,to=Stream,name=Overland_overflow
create link;type=channel2fixed,from=Stream,to=Outlet,name=Stream_outlet
setvalue; object=system, quantity=alloutputfile, value=output.txt
setvalue; object=system, quantity=simulation_start_time, value=0
setvalue; object=system, quantity=simulation_end_time, value=6
setvalue; object=system, quantity=initial_time_step, value=0.001
setvalue; object=system, quantity=minimum_timestep, value=1e-06
setvalue; object=system, quantity=write_interval, value=1
